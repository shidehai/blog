---
interface Props {
  storageKey: string;
}

const { storageKey } = Astro.props;
---

<button
  class="theme-control control--raised"
  type="button"
  data-theme-control
  data-theme-state="system"
  data-storage-key={storageKey}
  aria-label="主题：跟随系统"
  title="切换颜色主题"
>
  <svg class="theme-icon" aria-hidden="true" viewBox="0 0 24 24">
    <g data-theme-icon="system">
      <rect x="3" y="4" width="18" height="13" rx="2"></rect>
      <path d="M8 21h8M12 17v4"></path>
    </g>
    <g data-theme-icon="light">
      <circle cx="12" cy="12" r="4"></circle>
      <path
        d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"
      ></path>
    </g>
    <g data-theme-icon="dark">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
    </g>
  </svg>
  <span class="theme-label" data-theme-label>系统</span>
</button>

<script>
  type Theme = "system" | "light" | "dark";

  const themes: readonly Theme[] = ["system", "light", "dark"];
  const labels: Record<Theme, string> = {
    system: "系统",
    light: "浅色",
    dark: "深色",
  };

  const isTheme = (value: string | null): value is Theme =>
    value === "system" || value === "light" || value === "dark";

  for (const control of document.querySelectorAll<HTMLButtonElement>(
    "[data-theme-control]",
  )) {
    const key = control.dataset.storageKey;
    const label = control.querySelector<HTMLElement>("[data-theme-label]");
    if (!key || !label) continue;

    let theme: Theme = "system";
    try {
      const stored = localStorage.getItem(key);
      theme = isTheme(stored) ? stored : "system";
    } catch {
      // Storage can be disabled without affecting the system theme.
    }

    const applyTheme = (nextTheme: Theme) => {
      theme = nextTheme;
      control.dataset.themeState = theme;
      control.setAttribute("aria-label", `主题：${labels[theme]}`);
      control.title = `主题：${labels[theme]}，点击切换`;
      label.textContent = labels[theme];

      if (theme === "system") {
        delete document.documentElement.dataset.theme;
      } else {
        document.documentElement.dataset.theme = theme;
      }

      try {
        if (theme === "system") localStorage.removeItem(key);
        else localStorage.setItem(key, theme);
      } catch {
        // The active theme still works for this page when storage is blocked.
      }
    };

    applyTheme(theme);
    control.addEventListener("click", (event: MouseEvent) => {
      const index = themes.indexOf(theme);
      const nextTheme = themes[(index + 1) % themes.length] ?? "system";

      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      const docWithTransition = document as Document & {
        startViewTransition?: (callback: () => void) => {
          ready: Promise<void>;
        };
      };

      if (!docWithTransition.startViewTransition || prefersReducedMotion) {
        applyTheme(nextTheme);
        return;
      }

      const x = event.clientX || window.innerWidth / 2;
      const y = event.clientY || window.innerHeight / 2;
      const endRadius = Math.hypot(
        Math.max(x, window.innerWidth - x),
        Math.max(y, window.innerHeight - y),
      );

      const transition = docWithTransition.startViewTransition(() => {
        applyTheme(nextTheme);
      });

      transition.ready.then(() => {
        document.documentElement.animate(
          {
            clipPath: [
              `circle(0px at ${x}px ${y}px)`,
              `circle(${endRadius}px at ${x}px ${y}px)`,
            ],
          },
          {
            duration: 380,
            easing: "cubic-bezier(0.2, 0, 0, 1)",
            pseudoElement: "::view-transition-new(root)",
          },
        );
      });
    });
  }
</script>
