---
import type { Post } from "../lib/content.ts";
import { formatContentDate } from "../lib/content.ts";

interface Props {
  locale?: string;
  nextPost: Post | null;
  prevPost: Post | null;
  timezone: string;
}

const { locale = "zh-CN", nextPost, prevPost, timezone } = Astro.props;
if (!prevPost && !nextPost) return null;
---

<nav class="article-navigation" aria-label="文章前后导航">
  <div class="article-navigation__grid">
    {
      prevPost ? (
        <a
          href={prevPost.route}
          class="article-nav-card article-nav-card--prev surface--raised"
          rel="prev"
        >
          <span class="article-nav-card__direction">
            <svg
              class="article-nav-card__icon"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z"
                clip-rule="evenodd"
              />
            </svg>
            上一篇
          </span>
          <span class="article-nav-card__title">{prevPost.title}</span>
          <span class="article-nav-card__meta">
            <time datetime={prevPost.publishedAt}>
              {formatContentDate(prevPost.publishedAt, timezone, locale)}
            </time>
            {prevPost.topics[0] ? (
              <span class="article-nav-card__topic">
                #{prevPost.topics[0].name}
              </span>
            ) : null}
          </span>
        </a>
      ) : (
        <div class="article-nav-card--empty" aria-hidden="true" />
      )
    }

    {
      nextPost ? (
        <a
          href={nextPost.route}
          class="article-nav-card article-nav-card--next surface--raised"
          rel="next"
        >
          <span class="article-nav-card__direction">
            下一篇
            <svg
              class="article-nav-card__icon"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                clip-rule="evenodd"
              />
            </svg>
          </span>
          <span class="article-nav-card__title">{nextPost.title}</span>
          <span class="article-nav-card__meta">
            <time datetime={nextPost.publishedAt}>
              {formatContentDate(nextPost.publishedAt, timezone, locale)}
            </time>
            {nextPost.topics[0] ? (
              <span class="article-nav-card__topic">
                #{nextPost.topics[0].name}
              </span>
            ) : null}
          </span>
        </a>
      ) : (
        <div class="article-nav-card--empty" aria-hidden="true" />
      )
    }
  </div>
</nav>
