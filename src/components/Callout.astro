---
interface Props {
  type?: "note" | "important" | "warning";
  label?: string;
}

const { type = "note", label } = Astro.props;
const labels = {
  note: "说明",
  important: "重点",
  warning: "注意",
} as const;
---

<aside class={`callout callout--${type}`} aria-label={label ?? labels[type]}>
  <strong class="annotation-label">{label ?? labels[type]}</strong>
  <div class="callout-body"><slot /></div>
</aside>
