---
import ThemeControl from "./ThemeControl.astro";

interface Props {
  siteName: string;
  currentPath: string;
  themeStorageKey: string;
}

const { siteName, currentPath, themeStorageKey } = Astro.props;
const navigation = [
  { href: "/", label: "首页" },
  { href: "/writing/", label: "写作" },
  { href: "/notes/", label: "笔记" },
  { href: "/topics/", label: "主题" },
  { href: "/search/", label: "搜索" },
  { href: "/about/", label: "关于" },
] as const;
const isCurrent = (href: string) =>
  href === "/" ? currentPath === href : currentPath.startsWith(href);
---

<div class="site-header-frame">
  <header class="site-header surface--floating" data-site-header>
    <a class="site-brand" href="/" aria-label={`${siteName}首页`}>
      <span class="site-brand-mark" aria-hidden="true">知</span>
      <span>{siteName}</span>
    </a>

    <nav class="desktop-navigation" aria-label="主导航">
      {
        navigation.map(({ href, label }) => (
          <a
            class:list={["navigation-link", { "is-current": isCurrent(href) }]}
            href={href}
            aria-current={isCurrent(href) ? "page" : undefined}
          >
            {label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <ThemeControl storageKey={themeStorageKey} />
      <button
        class="mobile-navigation-trigger control--raised"
        type="button"
        popovertarget="mobile-navigation"
        aria-label="打开导航菜单"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <span>菜单</span>
      </button>
    </div>
  </header>

  <div
    id="mobile-navigation"
    class="mobile-navigation surface--floating"
    popover
  >
    <div class="mobile-navigation-heading">
      <strong>导航</strong>
      <button
        class="icon-control control--raised"
        type="button"
        popovertarget="mobile-navigation"
        popovertargetaction="hide"
        aria-label="关闭导航菜单"
        title="关闭导航菜单"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <nav aria-label="移动端主导航">
      {
        navigation.map(({ href, label }) => (
          <a
            class:list={[
              "mobile-navigation-link",
              { "is-current": isCurrent(href) },
            ]}
            href={href}
            aria-current={isCurrent(href) ? "page" : undefined}
          >
            {label}
          </a>
        ))
      }
    </nav>
  </div>
</div>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");

  if (header) {
    let compact = false;
    let scheduled = false;

    const updateHeader = () => {
      const nextCompact = window.scrollY > 72;
      if (nextCompact !== compact) {
        compact = nextCompact;
        header.dataset.compact = String(compact);
      }
      scheduled = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!scheduled) {
          scheduled = true;
          window.requestAnimationFrame(updateHeader);
        }
      },
      { passive: true },
    );
    updateHeader();
  }
</script>
