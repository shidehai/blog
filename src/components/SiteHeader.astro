---
import ThemeControl from "./ThemeControl.astro";

interface Props {
  siteName: string;
  currentPath: string;
  themeStorageKey: string;
  authorName: string;
  avatar?: {
    src: string;
    width: number;
    height: number;
  };
}

const { siteName, currentPath, themeStorageKey, authorName, avatar } =
  Astro.props;
const authorMark = Array.from(authorName.trim())[0] ?? "知";
const navigation = [
  { href: "/", label: "首页" },
  { href: "/writing/", label: "写作" },
  { href: "/notes/", label: "笔记" },
  { href: "/topics/", label: "主题" },
  { href: "/search/", label: "搜索" },
  { href: "/about/", label: "关于" },
] as const;
const isCurrent = (href: string) =>
  href === "/" ? currentPath === href : currentPath.startsWith(href);
---

<div class="site-header-frame">
  <header class="site-header surface--floating" data-site-header>
    <a class="site-brand" href="/" aria-label={`${siteName}首页`}>
      {
        avatar ? (
          <img
            class="site-brand-avatar"
            src={avatar.src}
            alt=""
            width={avatar.width}
            height={avatar.height}
            loading="eager"
            decoding="async"
          />
        ) : (
          <span class="site-brand-mark" aria-hidden="true">
            {authorMark}
          </span>
        )
      }
      <span class="site-brand-name">{siteName}</span>
    </a>

    <nav class="desktop-navigation" aria-label="主导航">
      {
        navigation.map(({ href, label }) => (
          <a
            class:list={["navigation-link", { "is-current": isCurrent(href) }]}
            href={href}
            aria-current={isCurrent(href) ? "page" : undefined}
          >
            {label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <ThemeControl storageKey={themeStorageKey} />
      <button
        class="mobile-navigation-trigger control--raised"
        type="button"
        popovertarget="mobile-navigation"
        aria-label="打开导航菜单"
        aria-controls="mobile-navigation"
        aria-expanded="false"
        title="打开导航菜单"
        data-mobile-navigation-trigger
      >
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <span class="visually-hidden">菜单</span>
      </button>
    </div>
  </header>

  <div
    id="mobile-navigation"
    class="mobile-navigation surface--floating"
    popover
  >
    <div class="mobile-navigation-heading">
      <div>
        <strong>浏览</strong>
        <span>{siteName}</span>
      </div>
      <button
        class="icon-control control--raised"
        type="button"
        popovertarget="mobile-navigation"
        popovertargetaction="hide"
        aria-label="关闭导航菜单"
        title="关闭导航菜单"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <nav aria-label="移动端主导航">
      {
        navigation.map(({ href, label }) => (
          <a
            class:list={[
              "mobile-navigation-link",
              { "is-current": isCurrent(href) },
            ]}
            href={href}
            aria-current={isCurrent(href) ? "page" : undefined}
          >
            {label}
          </a>
        ))
      }
    </nav>
  </div>
</div>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const menu = document.querySelector<HTMLElement>("#mobile-navigation");
  const menuTrigger = document.querySelector<HTMLButtonElement>(
    "[data-mobile-navigation-trigger]",
  );

  if (header) {
    let compact = false;
    let scheduled = false;

    const updateHeader = () => {
      const nextCompact = window.scrollY > 100;
      if (nextCompact !== compact) {
        compact = nextCompact;
        header.dataset.compact = String(compact);
      }
      scheduled = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!scheduled) {
          scheduled = true;
          window.requestAnimationFrame(updateHeader);
        }
      },
      { passive: true },
    );
    updateHeader();
  }

  menu?.addEventListener("beforetoggle", (event) => {
    if (!menuTrigger || !(event instanceof ToggleEvent)) return;
    const isOpen = event.newState === "open";
    menuTrigger.setAttribute("aria-expanded", String(isOpen));
    menuTrigger.setAttribute(
      "aria-label",
      isOpen ? "关闭导航菜单" : "打开导航菜单",
    );
    menuTrigger.title = isOpen ? "关闭导航菜单" : "打开导航菜单";
  });
</script>
