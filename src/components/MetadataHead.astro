---
import type { MetadataArticle, MetadataImage } from "../lib/metadata.ts";
import {
  buildStructuredData,
  serializeStructuredData,
} from "../lib/metadata.ts";
import type { SiteSettings } from "../lib/content.ts";

interface Props {
  article?: MetadataArticle;
  authorAvatar?: MetadataImage;
  canonicalUrl: string;
  description: string;
  image?: MetadataImage;
  noindex: boolean;
  pageTitle: string;
  settings: Pick<
    SiteSettings,
    | "authorName"
    | "defaultSeoDescription"
    | "locale"
    | "siteName"
    | "socialLinks"
  >;
  siteUrl: string;
}

const {
  article,
  authorAvatar,
  canonicalUrl,
  description,
  image,
  noindex,
  pageTitle,
  settings,
  siteUrl,
} = Astro.props;
const imageUrl = image ? new URL(image.src, siteUrl).href : undefined;
const feedUrl = new URL("/rss.xml", siteUrl).href;
const structuredData = noindex
  ? ""
  : serializeStructuredData(
      buildStructuredData({
        ...(article ? { article } : {}),
        ...(authorAvatar ? { authorAvatar } : {}),
        authorName: settings.authorName,
        canonicalUrl,
        description,
        ...(image ? { image } : {}),
        locale: settings.locale,
        pageTitle,
        siteDescription: settings.defaultSeoDescription,
        siteName: settings.siteName,
        siteUrl,
        socialLinks: settings.socialLinks,
      }),
    );
---

<meta name="description" content={description} />
<meta
  name="robots"
  content={noindex
    ? "noindex, nofollow"
    : "index, follow, max-image-preview:large"}
/>
{
  !noindex ? (
    <>
      <link rel="canonical" href={canonicalUrl} />
      <meta property="og:type" content={article ? "article" : "website"} />
      <meta property="og:locale" content={settings.locale.replace("-", "_")} />
      <meta property="og:site_name" content={settings.siteName} />
      <meta property="og:title" content={pageTitle} />
      <meta property="og:description" content={description} />
      <meta property="og:url" content={canonicalUrl} />
      {image && imageUrl ? (
        <>
          <meta property="og:image" content={imageUrl} />
          <meta property="og:image:type" content={image.mimeType} />
          <meta property="og:image:width" content={String(image.width)} />
          <meta property="og:image:height" content={String(image.height)} />
          <meta property="og:image:alt" content={image.alt} />
        </>
      ) : null}
      {article ? (
        <>
          <meta
            property="article:published_time"
            content={article.publishedAt}
          />
          <meta
            property="article:modified_time"
            content={article.updatedAt ?? article.publishedAt}
          />
          <meta property="article:author" content={settings.authorName} />
          {article.topics.map((topic) => (
            <meta property="article:tag" content={topic} />
          ))}
        </>
      ) : null}
      <meta
        name="twitter:card"
        content={image ? "summary_large_image" : "summary"}
      />
      <meta name="twitter:title" content={pageTitle} />
      <meta name="twitter:description" content={description} />
      {imageUrl ? <meta name="twitter:image" content={imageUrl} /> : null}
      {image ? <meta name="twitter:image:alt" content={image.alt} /> : null}
      <script is:inline type="application/ld+json" set:html={structuredData} />
    </>
  ) : null
}

{
  !noindex ? (
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${settings.siteName} RSS`}
      href={feedUrl}
    />
  ) : null
}
<link rel="manifest" href="/site.webmanifest" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
<meta
  name="theme-color"
  content="#eef1f4"
  media="(prefers-color-scheme: light)"
/>
<meta
  name="theme-color"
  content="#292a31"
  media="(prefers-color-scheme: dark)"
/>
