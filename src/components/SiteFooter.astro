---
interface Props {
  siteName: string;
  authorName: string;
  tagline: string | null;
  footerText: string | null;
  avatar?: {
    src: string;
    width: number;
    height: number;
  };
  socialLinks: readonly {
    label: string;
    url: string;
  }[];
}

const { siteName, authorName, tagline, footerText, avatar, socialLinks } =
  Astro.props;
const authorMark = Array.from(authorName.trim())[0] ?? "知";
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="site-footer-identity">
      {
        avatar ? (
          <img
            class="site-footer-avatar"
            src={avatar.src}
            alt=""
            width={avatar.width}
            height={avatar.height}
            loading="lazy"
            decoding="async"
          />
        ) : (
          <span
            class="site-footer-avatar site-footer-avatar--fallback"
            aria-hidden="true"
          >
            {authorMark}
          </span>
        )
      }
      <p>
        <strong>{authorName}</strong>
        <span>{tagline ?? "复杂想法，清晰写下；微小念头，也被留下。"}</span>
      </p>
    </div>

    <nav class="site-footer-navigation" aria-label="页脚导航">
      <a href="/writing/">写作</a>
      <a href="/notes/">笔记</a>
      <a href="/archive/">归档</a>
      <a href="/rss.xml">RSS</a>
      <a href="/about/">关于</a>
    </nav>

    {
      socialLinks.length ? (
        <nav class="site-footer-social" aria-label="站外链接">
          {socialLinks.map((link) => (
            <a
              href={link.url}
              target={/^https?:/.test(link.url) ? "_blank" : undefined}
              rel={
                /^https?:/.test(link.url) ? "me noopener noreferrer" : undefined
              }
            >
              {link.label}
            </a>
          ))}
        </nav>
      ) : null
    }

    <p class="site-footer-note">{footerText ?? siteName}</p>
  </div>
</footer>
