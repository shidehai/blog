---
import PostMeta from "./PostMeta.astro";
import TopicLink from "./TopicLink.astro";

interface Media {
  src: string;
  srcset?: string;
  alt: string;
  width: number;
  height: number;
}

interface Props {
  href: string;
  title: string;
  summary: string;
  kind: "article" | "tutorial";
  dateTime: string;
  dateLabel: string;
  readingMinutes: number;
  topic?: { href: string; label: string };
  media?: Media;
}

const {
  href,
  title,
  summary,
  kind,
  dateTime,
  dateLabel,
  readingMinutes,
  topic,
  media,
} = Astro.props;
const fallbackSignal =
  topic?.label ?? (kind === "tutorial" ? "实践教程" : "深度文章");
const fallbackPath = kind === "tutorial" ? "逐步验证" : "系统拆解";
---

<article
  class:list={["feature-post", "surface--raised", { "has-media": media }]}
>
  <div class="feature-post-copy">
    <div class="feature-post-topline">
      <span class="feature-label">当前推荐</span>
      {topic ? <TopicLink {...topic} /> : null}
    </div>
    <PostMeta {kind} {dateTime} {dateLabel} {readingMinutes} />
    <h2><a {href}>{title}</a></h2>
    <p>{summary}</p>
    <a class="feature-action" {href}>
      开始阅读
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </svg>
    </a>
  </div>
  {
    media ? (
      <div class="feature-post-media">
        <img
          src={media.src}
          srcset={media.srcset}
          sizes={
            media.srcset
              ? "(max-width: 48rem) calc(100vw - 2rem), (max-width: 56rem) calc(36vw - 8rem), (max-width: 64rem) calc(40vw - 8.8rem), (max-width: 78rem) calc(40vw - 9.8rem), 21.5rem"
              : undefined
          }
          alt={media.alt}
          width={media.width}
          height={media.height}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
    ) : (
      <div class="feature-post-signal" aria-hidden="true">
        <span>{fallbackSignal}</span>
        <strong>·</strong>
        <span>{fallbackPath}</span>
      </div>
    )
  }
</article>
