---
interface Props {
  code: string;
  language?: string;
  filename?: string;
}

const { code, language = "text", filename } = Astro.props;
---

<figure class="code-frame" data-code-block>
  <figcaption class="code-frame-header">
    <span>{filename ?? language}</span>
    <button class="code-copy control--raised" type="button" data-copy-code>
      <span data-copy-label>复制</span>
    </button>
  </figcaption>
  <pre tabindex="0"><code class={`language-${language}`}>{code}</code></pre>
</figure>

<script>
  document.addEventListener("click", async (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const button = target.closest<HTMLButtonElement>("[data-copy-code]");
    const block = button?.closest<HTMLElement>("[data-code-block]");
    const code = block?.querySelector("code")?.textContent;
    const label = button?.querySelector<HTMLElement>("[data-copy-label]");
    if (!button || !code || !label) return;

    try {
      await navigator.clipboard.writeText(code);
      label.textContent = "已复制";
      button.dataset.copied = "true";
    } catch {
      label.textContent = "复制失败";
    }

    window.setTimeout(() => {
      label.textContent = "复制";
      delete button.dataset.copied;
    }, 1800);
  });
</script>
