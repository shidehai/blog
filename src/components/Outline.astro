---
interface OutlineItem {
  id: string;
  text: string;
  level: 2 | 3;
}

interface Props {
  items: readonly OutlineItem[];
  embedded?: boolean;
}

const { items, embedded = false } = Astro.props;
---

<nav
  class:list={["article-outline", { "surface--inset": !embedded }]}
  aria-label="文章目录"
>
  {!embedded ? <strong class="annotation-label">目录</strong> : null}
  <ol>
    {
      items.map((item) => (
        <li data-level={item.level}>
          <a href={`#${item.id}`} data-outline-link>
            {item.text}
          </a>
        </li>
      ))
    }
  </ol>
</nav>
