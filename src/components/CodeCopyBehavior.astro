<script>
  const FEEDBACK_DURATION = 2000;
  const resetTimers = new WeakMap<Element, number>();

  function resetAfter(element: Element, callback: () => void) {
    const currentTimer = resetTimers.get(element);
    if (currentTimer) window.clearTimeout(currentTimer);
    resetTimers.set(element, window.setTimeout(callback, FEEDBACK_DURATION));
  }

  function setupReadingInteractions() {
    for (const label of document.querySelectorAll<HTMLElement>(
      "[data-copy-label]",
    )) {
      label.setAttribute("aria-live", "polite");
    }

    for (const frame of document.querySelectorAll<HTMLElement>(
      ".code-frame--collapsible",
    )) {
      if (frame.dataset.codeEnhanced === "true") continue;
      const toggle = frame.querySelector<HTMLButtonElement>(
        "[data-code-expand-toggle]",
      );
      if (!toggle) continue;
      frame.dataset.codeEnhanced = "true";
      frame.classList.add("is-collapsed");
      toggle.setAttribute("aria-expanded", "false");
    }

    document.documentElement.dataset.codeCopy = "ready";
  }

  async function handleReadingInteraction(event: MouseEvent) {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const headingAnchor = target.closest<HTMLAnchorElement>(
      "[data-heading-anchor]",
    );
    if (headingAnchor) {
      const publicRoute = document.querySelector<HTMLElement>(
        "[data-article-share]",
      )?.dataset.articleRoute;
      const baseUrl = new URL(
        publicRoute ?? window.location.pathname,
        location.origin,
      );
      const sectionUrl = new URL(
        headingAnchor.getAttribute("href") ?? "",
        baseUrl,
      ).href;
      const feedback = headingAnchor.parentElement?.querySelector<HTMLElement>(
        "[data-heading-anchor-feedback]",
      );

      try {
        await navigator.clipboard.writeText(sectionUrl);
        headingAnchor.dataset.copied = "true";
        delete headingAnchor.dataset.copyError;
        if (feedback) feedback.textContent = "小节链接已复制";
      } catch {
        headingAnchor.dataset.copyError = "true";
        delete headingAnchor.dataset.copied;
        if (feedback) feedback.textContent = "复制失败，已跳转到小节";
      }

      resetAfter(headingAnchor, () => {
        delete headingAnchor.dataset.copied;
        delete headingAnchor.dataset.copyError;
        if (feedback) feedback.textContent = "";
      });
      return;
    }

    const toggleBtn = target.closest<HTMLButtonElement>(
      "[data-code-expand-toggle]",
    );
    if (toggleBtn) {
      const frame = toggleBtn.closest<HTMLElement>(".code-frame");
      if (!frame) return;
      const lineCount = frame.dataset.lineCount || "";
      const isExpanded = toggleBtn.getAttribute("aria-expanded") !== "true";
      frame.classList.toggle("is-collapsed", !isExpanded);
      toggleBtn.setAttribute("aria-expanded", String(isExpanded));
      const btnSpan = toggleBtn.querySelector("span");
      if (!isExpanded) {
        if (btnSpan) btnSpan.textContent = `展开全部 (${lineCount} 行)`;
        toggleBtn.setAttribute("aria-label", `展开全部 ${lineCount} 行代码`);
      } else {
        if (btnSpan) btnSpan.textContent = "收起代码";
        toggleBtn.setAttribute("aria-label", "收起代码");
      }
      return;
    }

    const button = target.closest<HTMLButtonElement>("[data-copy-code]");
    const block = button?.closest<HTMLElement>("[data-code-block]");
    const code = block?.querySelector("code")?.textContent;
    const label = button?.querySelector<HTMLElement>("[data-copy-label]");
    if (!button || !code || !label) return;

    try {
      await navigator.clipboard.writeText(code);
      label.textContent = "已复制";
      button.dataset.copied = "true";
    } catch {
      label.textContent = "复制失败";
    }

    window.setTimeout(() => {
      label.textContent = "复制";
      delete button.dataset.copied;
    }, FEEDBACK_DURATION);
  }

  if (document.documentElement.dataset.readingInteractionsBound !== "true") {
    document.documentElement.dataset.readingInteractionsBound = "true";
    document.addEventListener("click", handleReadingInteraction);
    document.addEventListener("astro:page-load", setupReadingInteractions);
  }

  setupReadingInteractions();
</script>
