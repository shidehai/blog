---
import PageHeader from "../../components/PageHeader.astro";
import PostList from "../../components/PostList.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import { getPreparedSite } from "../../lib/site.ts";

export const prerender = true;

const { snapshot } = await getPreparedSite();
const { posts, settings, topics } = snapshot;
const recentPosts = posts.slice(0, 5);
const usedTopicIds = new Set(
  posts.flatMap((post) => post.topics.map((topic) => topic.id)),
);
const topicOptions = topics.filter((topic) => usedTopicIds.has(topic.id));
const monthFormatter = new Intl.DateTimeFormat(settings.locale, {
  month: "long",
  timeZone: settings.timezone,
  year: "numeric",
});
const monthOptions = Array.from(
  new Set(posts.map((post) => post.publishedAt.slice(0, 7))),
)
  .sort((left, right) => right.localeCompare(left))
  .map((value) => ({
    label: monthFormatter.format(new Date(`${value}-15T12:00:00.000Z`)),
    value,
  }));
const description = `搜索${settings.siteName}中的文章、教程与笔记。`;
---

<AppLayout title="搜索" {description} siteName={settings.siteName}>
  <div class="search-page" data-search-root data-locale={settings.locale}>
    <PageHeader
      title="搜索"
      description="从长文、教程与随手笔记中找到相关段落。"
    />

    <section class="search-workbench surface--inset" aria-label="全文搜索">
      <form action="/search/" method="get" role="search" data-search-form>
        <label class="search-label" for="search-query">关键词</label>
        <div class="search-field">
          <svg aria-hidden="true" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-4-4"></path>
          </svg>
          <input
            id="search-query"
            name="q"
            type="search"
            placeholder="标题、正文或技术名词"
            autocomplete="off"
            enterkeyhint="search"
            maxlength="100"
            aria-controls="search-results"
            aria-describedby="search-status"
            data-search-input
          />
          <button
            class="search-clear"
            type="reset"
            title="清除搜索"
            aria-label="清除搜索"
            data-search-reset
          >
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="M18 6 6 18M6 6l12 12"></path>
            </svg>
          </button>
          <button class="search-submit" type="submit">
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-4-4"></path>
            </svg>
            <span>搜索</span>
          </button>
        </div>

        <div class="search-filters" aria-label="缩小搜索范围">
          <label>
            <span>类型</span>
            <select name="kind" data-search-filter="kind">
              <option value="">全部类型</option>
              <option value="article">文章</option>
              <option value="tutorial">教程</option>
              <option value="note">笔记</option>
            </select>
          </label>
          <label>
            <span>主题</span>
            <select name="topic" data-search-filter="topic">
              <option value="">全部主题</option>
              {
                topicOptions.map((topic) => (
                  <option value={topic.slug}>{topic.name}</option>
                ))
              }
            </select>
          </label>
          <label>
            <span>时间</span>
            <select name="date" data-search-filter="date">
              <option value="">全部时间</option>
              {
                monthOptions.map((month) => (
                  <option value={month.value}>{month.label}</option>
                ))
              }
            </select>
          </label>
        </div>

        <p
          id="search-status"
          class="search-status"
          aria-live="polite"
          data-search-status
        >
        </p>
      </form>
    </section>

    <section
      class="search-default"
      aria-labelledby="recent-writing"
      data-search-default
    >
      <div class="section-heading">
        <h2 id="recent-writing">最近发布</h2>
        <a href="/archive/">完整归档</a>
      </div>
      <PostList posts={recentPosts} {settings} />
    </section>

    <section
      id="search-results"
      class="search-output"
      aria-labelledby="search-results-heading"
      aria-busy="false"
      data-search-output
      hidden
    >
      <div class="section-heading">
        <h2 id="search-results-heading">搜索结果</h2>
      </div>
      <ol class="search-results" data-search-results></ol>
    </section>
  </div>
</AppLayout>

<script>
  interface PagefindResultReference {
    data: () => Promise<unknown>;
  }

  interface PagefindModule {
    init?: () => Promise<void> | void;
    search: (
      query: string | null,
      options?: { filters: Record<string, string> },
    ) => Promise<unknown>;
  }

  interface SearchData {
    content: string;
    excerpt: string;
    filters: Record<string, unknown>;
    meta: Record<string, unknown>;
    url: string;
  }

  const isRecord = (value: unknown): value is Record<string, unknown> =>
    typeof value === "object" && value !== null;

  function isPagefindModule(value: unknown): value is PagefindModule {
    return isRecord(value) && typeof value.search === "function";
  }

  function isResultReference(value: unknown): value is PagefindResultReference {
    return isRecord(value) && typeof value.data === "function";
  }

  function resultReferences(
    value: unknown,
  ): readonly PagefindResultReference[] {
    if (!isRecord(value) || !Array.isArray(value.results)) {
      throw new Error("Pagefind returned an invalid result list");
    }
    if (!value.results.every(isResultReference)) {
      throw new Error("Pagefind returned an invalid result reference");
    }
    return value.results;
  }

  function searchData(value: unknown): SearchData | null {
    if (!isRecord(value) || typeof value.url !== "string") return null;
    return {
      content: typeof value.content === "string" ? value.content : "",
      excerpt: typeof value.excerpt === "string" ? value.excerpt : "",
      filters: isRecord(value.filters) ? value.filters : {},
      meta: isRecord(value.meta) ? value.meta : {},
      url: value.url,
    };
  }

  function stringValue(record: Record<string, unknown>, key: string): string {
    const value = record[key];
    return typeof value === "string" ? value : "";
  }

  function filterValues(
    filters: Record<string, unknown>,
    key: string,
  ): readonly string[] {
    const value = filters[key];
    if (typeof value === "string") return [value];
    if (Array.isArray(value)) {
      return value.filter((item): item is string => typeof item === "string");
    }
    return [];
  }

  function excerptFragment(data: SearchData): DocumentFragment {
    const source = data.excerpt || data.content;
    const parsed = new DOMParser().parseFromString(source, "text/html");
    const fragment = document.createDocumentFragment();
    let remaining = 180;

    const appendText = (value: string, parent: Node) => {
      if (remaining <= 0) return;
      const normalized = value.replace(/\s+/g, " ");
      const characters = Array.from(normalized).slice(0, remaining);
      if (characters.length > 0) {
        parent.appendChild(document.createTextNode(characters.join("")));
      }
      remaining -= characters.length;
    };

    const appendNode = (node: Node, parent: Node) => {
      if (remaining <= 0) return;
      if (node.nodeType === Node.TEXT_NODE) {
        appendText(node.textContent ?? "", parent);
        return;
      }
      if (!(node instanceof HTMLElement)) return;
      if (node.tagName === "MARK") {
        const mark = document.createElement("mark");
        for (const child of node.childNodes) appendNode(child, mark);
        if (mark.textContent) parent.appendChild(mark);
        return;
      }
      for (const child of node.childNodes) appendNode(child, parent);
    };

    for (const child of parsed.body.childNodes) {
      appendNode(child, fragment);
      appendText(" ", fragment);
    }
    if (!fragment.textContent?.trim()) fragment.append("打开内容查看详情");
    return fragment;
  }

  function safeResultUrl(value: string): string | null {
    const url = new URL(value, window.location.origin);
    if (url.origin !== window.location.origin) return null;
    return `${url.pathname}${url.search}${url.hash}`;
  }

  const kindLabels = new Map([
    ["article", "文章"],
    ["tutorial", "教程"],
    ["note", "笔记"],
  ]);

  document
    .querySelectorAll<HTMLElement>("[data-search-root]")
    .forEach((root) => {
      const form = root.querySelector<HTMLFormElement>("[data-search-form]");
      const input = root.querySelector<HTMLInputElement>("[data-search-input]");
      const output = root.querySelector<HTMLElement>("[data-search-output]");
      const results = root.querySelector<HTMLOListElement>(
        "[data-search-results]",
      );
      const status = root.querySelector<HTMLElement>("[data-search-status]");
      const defaultContent = root.querySelector<HTMLElement>(
        "[data-search-default]",
      );
      const selects = Array.from(
        root.querySelectorAll<HTMLSelectElement>("[data-search-filter]"),
      );
      if (!form || !input || !output || !results || !status || !defaultContent)
        return;

      const searchForm = form;
      const searchInput = input;
      const searchOutput = output;
      const searchResults = results;
      const searchStatus = status;
      const recentContent = defaultContent;

      const topicSelect = selects.find((select) => select.name === "topic");
      const topicLabels = new Map(
        Array.from(topicSelect?.options ?? []).map((option) => [
          option.value,
          option.text,
        ]),
      );
      let pagefindPromise: Promise<PagefindModule> | undefined;
      let debounceTimer: number | undefined;
      let searchSequence = 0;

      function loadPagefind(): Promise<PagefindModule> {
        if (!pagefindPromise) {
          const pagefindPath = "/pagefind/pagefind.js";
          pagefindPromise = import(/* @vite-ignore */ pagefindPath)
            .then(async (module: unknown) => {
              if (!isPagefindModule(module)) {
                throw new Error("Pagefind module is unavailable");
              }
              await module.init?.();
              return module;
            })
            .catch((error: unknown) => {
              pagefindPromise = undefined;
              throw error;
            });
        }
        return pagefindPromise;
      }

      function selectedFilter(name: string): string {
        return selects.find((select) => select.name === name)?.value ?? "";
      }

      function matchesFilters(data: SearchData): boolean {
        return ["kind", "topic", "date"].every((name) => {
          const selected = selectedFilter(name);
          return (
            !selected || filterValues(data.filters, name).includes(selected)
          );
        });
      }

      function pagefindFilters(): Record<string, string> {
        return Object.fromEntries(
          selects
            .filter((select) => Boolean(select.value))
            .map((select) => [select.name, select.value]),
        );
      }

      function updateLocation(query: string): void {
        const parameters = new URLSearchParams();
        if (query) parameters.set("q", query);
        for (const select of selects) {
          if (select.value) parameters.set(select.name, select.value);
        }
        const serialized = parameters.toString();
        window.history.replaceState(
          null,
          "",
          `${window.location.pathname}${serialized ? `?${serialized}` : ""}`,
        );
      }

      function createResult(data: SearchData): HTMLLIElement | null {
        const href = safeResultUrl(data.url);
        if (!href) return null;
        const title = stringValue(data.meta, "title") || href;
        const date = stringValue(data.meta, "date");
        const kinds = filterValues(data.filters, "kind");
        const topics = filterValues(data.filters, "topic");

        const item = document.createElement("li");
        item.className = "search-result surface--raised";
        const article = document.createElement("article");
        const metadata = document.createElement("p");
        metadata.className = "search-result-meta";
        const labels = [
          kinds[0] ? (kindLabels.get(kinds[0]) ?? kinds[0]) : "",
          date,
          ...topics.map((topic) => topicLabels.get(topic) ?? topic),
        ].filter(Boolean);
        metadata.textContent = labels.join(" · ");

        const heading = document.createElement("h3");
        const link = document.createElement("a");
        link.href = href;
        link.textContent = title;
        heading.append(link);

        const excerpt = document.createElement("p");
        excerpt.className = "search-result-excerpt";
        excerpt.append(excerptFragment(data));
        if (labels.length > 0) article.append(metadata);
        article.append(heading, excerpt);
        item.append(article);
        return item;
      }

      function showDefault(message = ""): void {
        searchOutput.hidden = true;
        searchOutput.setAttribute("aria-busy", "false");
        recentContent.hidden = false;
        searchResults.replaceChildren();
        searchStatus.textContent = message;
      }

      function showNoResults(): void {
        const item = document.createElement("li");
        item.className = "search-empty surface--inset";
        const heading = document.createElement("h3");
        heading.textContent = "没有找到匹配内容";
        const copy = document.createElement("p");
        copy.textContent = "可以换一个关键词，或放宽类型、主题与时间范围。";
        item.append(heading, copy);
        searchResults.replaceChildren(item);
        searchOutput.hidden = false;
        searchOutput.setAttribute("aria-busy", "false");
        recentContent.hidden = true;
      }

      async function runSearch(): Promise<void> {
        const sequence = ++searchSequence;
        const query = searchInput.value.trim();
        const hasFilter = selects.some((select) => Boolean(select.value));
        updateLocation(query);
        if (!query && !hasFilter) {
          showDefault();
          return;
        }

        searchOutput.hidden = false;
        searchOutput.setAttribute("aria-busy", "true");
        recentContent.hidden = true;
        searchStatus.textContent = "正在载入搜索索引…";
        try {
          const pagefind = await loadPagefind();
          const response = await pagefind.search(query || null, {
            filters: pagefindFilters(),
          });
          const references = resultReferences(response);
          const loaded = await Promise.all(
            references.map((reference) => reference.data()),
          );
          if (sequence !== searchSequence) return;
          const matches = loaded
            .map(searchData)
            .filter(
              (data): data is SearchData =>
                data !== null && matchesFilters(data),
            );
          const nodes = matches
            .map(createResult)
            .filter((node): node is HTMLLIElement => node !== null);
          if (nodes.length === 0) {
            showNoResults();
            searchStatus.textContent = "没有匹配结果";
            return;
          }
          searchResults.replaceChildren(...nodes);
          searchOutput.hidden = false;
          searchOutput.setAttribute("aria-busy", "false");
          recentContent.hidden = true;
          searchStatus.textContent = `找到 ${nodes.length} 条结果`;
        } catch (error) {
          console.error("Search index failed to load", error);
          if (sequence !== searchSequence) return;
          showDefault("搜索索引暂时不可用，以下仍可浏览最近发布内容。");
        }
      }

      const initial = new URLSearchParams(window.location.search);
      searchInput.value = initial.get("q")?.slice(0, 100) ?? "";
      for (const select of selects) {
        const value = initial.get(select.name) ?? "";
        if (
          Array.from(select.options).some((option) => option.value === value)
        ) {
          select.value = value;
        }
        select.addEventListener("change", () => void runSearch());
      }

      searchForm.addEventListener("submit", (event) => {
        event.preventDefault();
        window.clearTimeout(debounceTimer);
        void runSearch();
      });
      searchForm.addEventListener("reset", (event) => {
        event.preventDefault();
        window.clearTimeout(debounceTimer);
        searchInput.value = "";
        for (const select of selects) select.value = "";
        searchSequence += 1;
        updateLocation("");
        showDefault();
        searchInput.focus();
      });
      searchInput.addEventListener("input", () => {
        window.clearTimeout(debounceTimer);
        debounceTimer = window.setTimeout(() => void runSearch(), 180);
      });

      if (
        searchInput.value ||
        selects.some((select) => Boolean(select.value))
      ) {
        void runSearch();
      }
    });
</script>

<style>
  .search-page {
    inline-size: min(100%, var(--discovery-width));
    margin-inline: auto;
  }

  .search-workbench {
    padding: var(--space-6);
    border-radius: var(--radius-module);
  }

  .search-label,
  .search-filters label > span {
    display: block;
    margin-block-end: var(--space-2);
    color: var(--ink-muted);
    font-size: var(--font-size-13);
    font-weight: 650;
  }

  .search-field {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) var(--control-size) auto;
    align-items: center;
    min-block-size: 3.5rem;
    padding-inline-start: var(--space-4);
    border-radius: var(--radius-control);
    background: var(--surface-high);
    box-shadow: var(--depth-inset);
  }

  .search-field > svg {
    color: var(--signal);
  }

  .search-field input {
    appearance: none;
    min-inline-size: 0;
    min-block-size: 3.5rem;
    padding-inline: var(--space-3);
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--ink);
  }

  .search-field input::placeholder {
    color: var(--ink-muted);
    opacity: 1;
  }

  .search-field input::-webkit-search-cancel-button {
    display: none;
    appearance: none;
  }

  .search-field:focus-within {
    box-shadow: var(--focus-ring);
  }

  .search-field input:focus-visible,
  .search-field button:focus-visible {
    box-shadow: none;
  }

  .search-clear,
  .search-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: var(--control-size);
    border: 0;
    cursor: pointer;
  }

  .search-clear {
    inline-size: var(--control-size);
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--ink-muted);
  }

  .search-submit {
    gap: var(--space-2);
    align-self: stretch;
    min-inline-size: 7rem;
    padding-inline: var(--space-4);
    border-radius: 0 var(--radius-control) var(--radius-control) 0;
    background: var(--signal);
    color: var(--signal-ink);
    font-size: var(--font-size-14);
    font-weight: 700;
  }

  .search-filters {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin-block-start: var(--space-5);
  }

  .search-filters select {
    inline-size: 100%;
    min-block-size: var(--control-size);
    padding-inline: var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-control);
    background: var(--surface);
    color: var(--ink);
  }

  .search-status {
    min-block-size: 1.8em;
    margin: var(--space-3) 0 0;
    color: var(--ink-muted);
    font-size: var(--font-size-13);
  }

  .search-default,
  .search-output {
    margin-block-start: var(--space-8);
  }

  .search-results {
    display: grid;
    gap: var(--space-5);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  :global(.search-result.surface--raised) {
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-row);
    background: var(--surface-row);
    box-shadow: var(--depth-raised-compact);
    transition:
      background-color var(--motion-base) var(--ease-material),
      box-shadow var(--motion-base) var(--ease-material);
  }

  :global(.search-result h3) {
    margin-block: var(--space-2);
    font-size: var(--font-size-18);
  }

  :global(.search-result h3 a) {
    color: var(--ink);
    text-decoration: none;
  }

  :global(.search-result-meta),
  :global(.search-result-excerpt) {
    margin-block-end: 0;
  }

  :global(.search-result-meta) {
    color: var(--ink-muted);
    font-size: var(--font-size-12);
  }

  :global(.search-result-excerpt) {
    max-inline-size: 70ch;
    color: var(--ink-muted);
  }

  :global(.search-result-excerpt mark) {
    border-radius: 0.2em;
    background: var(--signal-soft);
    color: var(--ink);
    font-weight: 650;
  }

  :global(.search-empty) {
    padding: var(--space-6);
    border-radius: var(--radius-module);
    text-align: center;
  }

  :global(.search-empty h3) {
    margin-block-end: var(--space-2);
    font-size: var(--font-size-20);
  }

  :global(.search-empty p) {
    margin-block-end: 0;
    color: var(--ink-muted);
  }

  :global(.search-result.surface--raised:has(h3 a:focus-visible)),
  :global(.search-result.surface--raised:has(h3 a:active)) {
    background: var(--surface-high);
    box-shadow: var(--depth-pressed);
  }

  @media (hover: hover) and (pointer: fine) {
    :global(.search-result.surface--raised:has(h3 a:hover)) {
      background: var(--surface-high);
      box-shadow: var(--depth-pressed);
    }
  }

  @media (max-width: 40rem) {
    .search-workbench {
      padding: var(--space-5);
    }

    .search-field {
      grid-template-columns: auto minmax(0, 1fr) var(--control-size);
    }

    .search-submit {
      grid-column: 1 / -1;
      min-block-size: var(--control-size);
      border-radius: 0 0 var(--radius-control) var(--radius-control);
    }

    .search-filters {
      grid-template-columns: 1fr;
    }
  }

  @media (forced-colors: active) {
    .search-workbench,
    :global(.search-result),
    :global(.search-empty) {
      border: 1px solid CanvasText;
    }

    .search-submit {
      border: 1px solid ButtonText;
    }
  }
</style>
