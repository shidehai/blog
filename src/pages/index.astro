---
import FeaturePost from "../components/FeaturePost.astro";
import PostListRow from "../components/PostListRow.astro";
import TopicLink from "../components/TopicLink.astro";
import AppLayout from "../layouts/AppLayout.astro";

export const prerender = true;
---

<AppLayout
  title="个人知识站"
  description="技术文章、教程与随手笔记组成的个人知识站。"
>
  <div class="home-page">
    <h1 class="visually-hidden">个人知识站</h1>

    <section class="home-intro-grid" aria-label="作者与当前推荐">
      <FeaturePost
        href="/writing/recoverable-static-publishing/"
        title="从一次失败回滚，设计真正可恢复的静态发布流水线"
        summary="把内容校验、候选镜像预检和旧版本回滚串成一条能解释、能重跑、也能在凌晨放心交给自动化的路径。"
        kind="tutorial"
        dateTime="2026-08-04T02:30:00.000Z"
        dateLabel="2026 年 8 月 4 日"
        readingMinutes={12}
        topic={{ href: "/topics/delivery/", label: "交付系统" }}
      />

      <aside class="identity-module surface--raised">
        <div class="identity-lockup">
          <span class="identity-avatar" aria-hidden="true">示</span>
          <div>
            <p class="identity-name">示例作者</p>
            <p class="identity-role">软件工程与长期写作</p>
          </div>
        </div>
        <p class="identity-statement">
          复杂想法，清晰写下；<br />微小念头，也被留下。
        </p>
        <p class="identity-note">
          这里收录可复现的技术实践、教程，以及还值得继续想一想的片段。
        </p>
      </aside>
    </section>

    <section class="home-section" aria-labelledby="latest-writing">
      <div class="section-heading">
        <h2 id="latest-writing">最近写作</h2>
        <a href="/writing/">查看全部</a>
      </div>
      <div class="post-list">
        <PostListRow
          href="/writing/content-boundaries/"
          title="内容边界不是类型声明：在构建时验证 CMS 数据"
          summary="从不可信 API 响应到稳定页面模型，只保留一次解析、一次归一化和一条失败得足够清楚的路径。"
          kind="article"
          dateTime="2026-08-01T11:20:00.000Z"
          dateLabel="2026 年 8 月 1 日"
          readingMinutes={8}
          topics={[{ href: "/topics/astro/", label: "Astro" }]}
        />
        <PostListRow
          href="/writing/chinese-reading-rhythm/"
          title="让中文技术长文读起来更稳：字宽、行高与注释脊线"
          summary="用一组可测量的排版约束，让代码、图表与正文共享节奏，而不是彼此争夺注意力。"
          kind="article"
          dateTime="2026-07-28T08:10:00.000Z"
          dateLabel="2026 年 7 月 28 日"
          readingMinutes={6}
          topics={[{ href: "/topics/reading/", label: "阅读设计" }]}
        />
      </div>
    </section>

    <div class="home-secondary-grid">
      <section
        class="notes-module surface--raised"
        aria-labelledby="recent-notes"
      >
        <div class="section-heading">
          <h2 id="recent-notes">近期笔记</h2>
          <a href="/notes/">全部笔记</a>
        </div>
        <ul class="note-list">
          <li>
            <a href="/notes/native-popover/">
              <time datetime="2026-08-03">08-03</time>
              <span>原生 Popover 已经足够承担一个安静、可退出的移动导航。</span>
            </a>
          </li>
          <li>
            <a href="/notes/build-failures/">
              <time datetime="2026-07-30">07-30</time>
              <span>构建失败应该指出内容记录与字段，而不是只留下一段堆栈。</span
              >
            </a>
          </li>
        </ul>
      </section>

      <section
        class="topics-module surface--raised"
        aria-labelledby="active-topics"
      >
        <h2 id="active-topics">持续关注</h2>
        <div class="topic-list">
          <TopicLink href="/topics/astro/" label="Astro" />
          <TopicLink href="/topics/delivery/" label="交付系统" />
          <TopicLink href="/topics/reading/" label="阅读设计" />
          <TopicLink href="/topics/postgresql/" label="PostgreSQL" />
        </div>
      </section>
    </div>

    <nav class="shortcut-grid" aria-label="更多浏览方式">
      <a class="shortcut-link surface--raised" href="/search/">
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <span>搜索全文</span>
      </a>
      <a class="shortcut-link surface--raised" href="/archive/">
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M3 6h18M5 6v14h14V6M9 10h6"></path>
          <path d="M4 3h16v3H4z"></path>
        </svg>
        <span>按时间归档</span>
      </a>
      <a class="shortcut-link surface--raised" href="/rss.xml">
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"></path>
          <circle cx="5" cy="19" r="1"></circle>
        </svg>
        <span>订阅 RSS</span>
      </a>
    </nav>
  </div>
</AppLayout>
