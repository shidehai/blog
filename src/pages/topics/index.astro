---
import EmptyState from "../../components/EmptyState.astro";
import PageHeader from "../../components/PageHeader.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import { getPreparedSite } from "../../lib/site.ts";

export const prerender = true;

const { snapshot } = await getPreparedSite();
const { posts, settings } = snapshot;
const topicCards = snapshot.topics.map((topic) => {
  const postCount = posts.filter((post) =>
    post.topics.some((postTopic) => postTopic.id === topic.id),
  ).length;
  const latinMarker = topic.name.match(/[A-Za-z]+/)?.[0];

  return {
    marker:
      latinMarker?.slice(0, 3).toUpperCase() ??
      Array.from(topic.name.trim())[0] ??
      "题",
    postCount,
    topic,
  };
});
---

<AppLayout
  title="主题"
  description="沿主题浏览文章、教程与笔记。"
  siteName={settings.siteName}
>
  <div class="page-shell topics-page">
    <PageHeader
      title="主题"
      description="主题把长文与短笔记放回同一条思考路径，而不是把内容切成互不相干的栏目。"
    />

    {
      topicCards.length ? (
        <ul class="topic-directory" aria-label="全部主题">
          {topicCards.map(({ marker, postCount, topic }) => (
            <li>
              <a
                class="topic-directory-card surface--raised"
                href={`/topics/${topic.slug}/`}
                aria-label={`${topic.name}，${postCount} 篇内容`}
              >
                <span class="topic-directory-mark" aria-hidden="true">
                  {marker}
                </span>
                <h2>{topic.name}</h2>
                <span class="topic-directory-count">{postCount} 篇内容</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <EmptyState
          title="还没有公开主题"
          actionHref="/archive/"
          actionLabel="浏览完整归档"
        >
          <p>所有已发布内容仍可按时间连续浏览。</p>
        </EmptyState>
      )
    }
  </div>
</AppLayout>
