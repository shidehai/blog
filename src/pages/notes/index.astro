---
import EmptyState from "../../components/EmptyState.astro";
import PageHeader from "../../components/PageHeader.astro";
import PostList from "../../components/PostList.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import { getPreparedSite } from "../../lib/site.ts";

export const prerender = true;

const { snapshot } = await getPreparedSite();
const { settings } = snapshot;
const notes = snapshot.posts.filter((post) => post.kind === "note");
---

<AppLayout
  title="笔记"
  description="简短记录、观察与尚在生长的想法。"
  siteName={settings.siteName}
>
  <div class="page-shell notes-page">
    <PageHeader
      title="笔记"
      description="不需要铺成长文的发现，也沿着同一条时间线被认真保存。"
    />

    <nav class="browse-toolbar surface--inset" aria-label="笔记浏览方式">
      <a class="filter-link is-current" href="/notes/" aria-current="page">
        时间流 <span>{notes.length}</span>
      </a>
      <a class="filter-link" href="/topics/">按主题</a>
      <a class="filter-link" href="/archive/">完整归档</a>
    </nav>

    {
      notes.length ? (
        <section
          class="notes-stream"
          data-browse-mode="chronological"
          aria-labelledby="notes-stream-heading"
        >
          <h2 id="notes-stream-heading" class="visually-hidden">
            全部笔记
          </h2>
          <PostList posts={notes} settings={settings} />
        </section>
      ) : (
        <EmptyState
          title="笔记流暂时为空"
          actionHref="/writing/"
          actionLabel="浏览文章与教程"
        >
          <p>现有的完整写作仍按发布时间保留在写作页。</p>
        </EmptyState>
      )
    }
  </div>
</AppLayout>
