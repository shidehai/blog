---
import { timingSafeEqual } from "node:crypto";

import { z } from "zod";

import PostPage from "../../components/PostPage.astro";
import {
  deriveRelatedPosts,
  loadPreviewSnapshot,
  type Post,
  type PublishedSnapshot,
} from "../../lib/content.ts";
import {
  renderMarkdown,
  type MarkdownMedia,
  type RenderedMarkdown,
} from "../../lib/markdown.ts";
import { resolvePreviewMediaAsset } from "../../lib/media.ts";
import { readRuntimeEnv } from "../../../scripts/env.mjs";

export const prerender = false;

const environment = readRuntimeEnv();

function trusted(actual: string | null, expected: string | undefined): boolean {
  if (!actual || !expected || expected.length < 24) return false;
  const actualBytes = Buffer.from(actual);
  const expectedBytes = Buffer.from(expected);
  return (
    actualBytes.length === expectedBytes.length &&
    timingSafeEqual(actualBytes, expectedBytes)
  );
}

if (
  !trusted(
    Astro.request.headers.get("x-preview-trusted"),
    environment.PREVIEW_TRUSTED_HEADER,
  )
) {
  return new Response("预览不可用\n", {
    headers: {
      "Cache-Control": "private, no-store",
      "Content-Type": "text/plain; charset=utf-8",
      "X-Robots-Tag": "noindex, nofollow",
    },
    status: 404,
  });
}

const idResult = z.uuid().safeParse(Astro.params.id);
const version = Astro.url.searchParams.get("version") ?? undefined;
if (
  !idResult.success ||
  (version !== undefined && !/^[A-Za-z0-9_-]{1,128}$/.test(version))
) {
  return new Response("预览不可用\n", {
    headers: {
      "Cache-Control": "private, no-store",
      "Content-Type": "text/plain; charset=utf-8",
      "X-Robots-Tag": "noindex, nofollow",
    },
    status: 404,
  });
}

let snapshot: PublishedSnapshot;
let media: ReadonlyMap<string, MarkdownMedia>;
let post: Post;
let output: RenderedMarkdown;

try {
  if (environment.CONTENT_SOURCE === "fixture") {
    const prepared = await import("../../lib/site.ts").then(
      ({ getPreparedSite }) => getPreparedSite(),
    );
    const fixturePost = prepared.snapshot.posts.find(
      (candidate) => candidate.id === idResult.data,
    );
    const fixtureOutput = prepared.renderedPosts.get(idResult.data);
    if (!fixturePost || !fixtureOutput) {
      return new Response("预览不可用\n", {
        headers: {
          "Cache-Control": "private, no-store",
          "Content-Type": "text/plain; charset=utf-8",
          "X-Robots-Tag": "noindex, nofollow",
        },
        status: 404,
      });
    }
    snapshot = prepared.snapshot;
    media = prepared.media;
    post = fixturePost;
    output = fixtureOutput;
  } else {
    snapshot = await loadPreviewSnapshot({
      id: idResult.data,
      token: environment.DIRECTUS_PREVIEW_TOKEN,
      url: environment.DIRECTUS_URL,
      ...(version ? { version } : {}),
    });
    const previewPost = snapshot.posts[0];
    if (!previewPost) {
      return new Response("预览不可用\n", {
        headers: {
          "Cache-Control": "private, no-store",
          "Content-Type": "text/plain; charset=utf-8",
          "X-Robots-Tag": "noindex, nofollow",
        },
        status: 404,
      });
    }

    // ponytail: inline protected assets avoid token-bearing URLs; add an
    // authenticated asset endpoint only if preview HTML size becomes material.
    media = new Map(
      await Promise.all(
        snapshot.files.map(async (file) => {
          const asset = await resolvePreviewMediaAsset(
            {
              filename_download: file.filename,
              filesize: file.filesize,
              folder: file.folderId,
              height: file.height,
              id: file.id,
              type: file.mimeType,
              width: file.width,
            },
            {
              directusUrl: environment.DIRECTUS_URL,
              token: environment.DIRECTUS_PREVIEW_TOKEN,
            },
          );
          return [
            file.id,
            {
              height: asset.height,
              id: file.id,
              mimeType: asset.mimeType,
              src: `data:${asset.mimeType};base64,${asset.bytes.toString("base64")}`,
              width: asset.width,
            },
          ] as const;
        }),
      ),
    );
    post = previewPost;
    output = await renderMarkdown(post.body, {
      media,
      source: `preview post ${post.id} body`,
    });
  }
} catch {
  return new Response("预览不可用\n", {
    headers: {
      "Cache-Control": "private, no-store",
      "Content-Type": "text/plain; charset=utf-8",
      "X-Robots-Tag": "noindex, nofollow",
    },
    status: 404,
  });
}

Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
const related = deriveRelatedPosts(post, snapshot.posts);
---

<PostPage {media} {output} {post} {related} settings={snapshot.settings} />
