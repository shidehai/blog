---
import PageHeader from "../components/PageHeader.astro";
import AppLayout from "../layouts/AppLayout.astro";
import { getPreparedSite } from "../lib/site.ts";

export const prerender = true;

const { snapshot } = await getPreparedSite();
const { settings } = snapshot;
const currentWriting =
  snapshot.posts.find((post) => post.kind !== "note") ?? snapshot.posts[0];
---

<AppLayout
  title="页面未找到"
  description="请求的页面不存在，可以返回当前写作或完整归档。"
  siteName={settings.siteName}
>
  <div class="page-shell not-found-page">
    <PageHeader
      title="这里没有这一页"
      description="链接可能已经输入错误，或者指向一条尚未公开的内容。"
    />

    <section
      class="not-found-panel surface--inset"
      aria-labelledby="next-route"
    >
      <p class="not-found-code" aria-hidden="true">404</p>
      <div>
        <h2 id="next-route">从仍然有效的入口继续</h2>
        <nav aria-label="页面未找到后的导航">
          {
            currentWriting ? (
              <a class="primary-action" href={currentWriting.route}>
                阅读当前写作
              </a>
            ) : null
          }
          <a class="secondary-action" href="/writing/">浏览写作</a>
          <a class="secondary-action" href="/archive/">查看归档</a>
          <a class="secondary-action" href="/">返回首页</a>
        </nav>
      </div>
    </section>
  </div>
</AppLayout>
