---
import EmptyState from "../../components/EmptyState.astro";
import PageHeader from "../../components/PageHeader.astro";
import PostMeta from "../../components/PostMeta.astro";
import TopicLink from "../../components/TopicLink.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import { formatContentDate } from "../../lib/content.ts";
import { getPreparedSite } from "../../lib/site.ts";

export const prerender = true;

const { snapshot } = await getPreparedSite();
const { posts, settings } = snapshot;
const years = new Map<string, typeof posts>();
for (const post of posts) {
  const year = post.publishedAt.slice(0, 4);
  years.set(year, [...(years.get(year) ?? []), post]);
}
---

<AppLayout
  title="归档"
  description="文章、教程与笔记的完整时间归档。"
  siteName={settings.siteName}
>
  <div class="page-shell archive-page">
    <PageHeader
      title="归档"
      description="不做无限滚动，也不依赖热度排序；每一条公开记录都按时间留在这里。"
    />

    <nav class="browse-toolbar surface--inset" aria-label="归档内容类型">
      <a class="filter-link is-current" href="/archive/" aria-current="page">
        全部 <span>{posts.length}</span>
      </a>
      <a class="filter-link" href="/writing/">文章与教程</a>
      <a class="filter-link" href="/notes/">笔记</a>
      <a class="filter-link" href="/topics/">主题</a>
    </nav>

    {
      years.size ? (
        <div class="archive-years">
          {[...years].map(([year, yearPosts]) => (
            <section class="archive-year" aria-labelledby={`year-${year}`}>
              <div class="archive-year-heading">
                <h2 id={`year-${year}`}>{year}</h2>
                <span>{yearPosts.length} 篇</span>
              </div>
              <ol class="archive-list">
                {yearPosts.map((post) => (
                  <li>
                    <article class="archive-row surface--raised">
                      <div class="archive-row-copy">
                        <PostMeta
                          kind={post.kind}
                          dateTime={post.publishedAt}
                          dateLabel={formatContentDate(
                            post.publishedAt,
                            settings.timezone,
                            settings.locale,
                          )}
                          {...(post.kind === "note"
                            ? {}
                            : { readingMinutes: post.readingMinutes })}
                        />
                        <h3>
                          <a href={post.route}>{post.title}</a>
                        </h3>
                      </div>
                      {post.topics.length ? (
                        <div class="topic-list" aria-label="主题">
                          {post.topics.map((topic) => (
                            <TopicLink
                              href={`/topics/${topic.slug}/`}
                              label={topic.name}
                            />
                          ))}
                        </div>
                      ) : null}
                    </article>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
      ) : (
        <EmptyState title="归档暂时为空" actionHref="/" actionLabel="返回首页">
          <p>第一条公开内容发布后，会按年份稳定地出现在这里。</p>
        </EmptyState>
      )
    }
  </div>
</AppLayout>
