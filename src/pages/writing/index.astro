---
import EmptyState from "../../components/EmptyState.astro";
import PageHeader from "../../components/PageHeader.astro";
import PostList from "../../components/PostList.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import { getPreparedSite } from "../../lib/site.ts";

export const prerender = true;

const { snapshot } = await getPreparedSite();
const { settings } = snapshot;
const tutorials = snapshot.posts.filter((post) => post.kind === "tutorial");
const articles = snapshot.posts.filter((post) => post.kind === "article");
const writingCount = tutorials.length + articles.length;
---

<AppLayout
  title="写作"
  description="技术文章与教程，按发布时间浏览。"
  siteName={settings.siteName}
>
  <div class="page-shell writing-page">
    <PageHeader
      title="写作"
      description="较完整的技术文章与可跟随的教程，都从同一份公开内容快照生成。"
    />

    <nav class="browse-toolbar surface--inset" aria-label="写作分类">
      <a class="filter-link is-current" href="/writing/" aria-current="page">
        全部 <span>{writingCount}</span>
      </a>
      {
        tutorials.length ? (
          <a class="filter-link" href="#tutorials">
            教程 <span>{tutorials.length}</span>
          </a>
        ) : null
      }
      {
        articles.length ? (
          <a class="filter-link" href="#articles">
            文章 <span>{articles.length}</span>
          </a>
        ) : null
      }
      <a class="filter-link" href="/topics/">按主题</a>
      <a class="filter-link" href="/archive/">按时间</a>
    </nav>

    {
      writingCount ? (
        <div class="discovery-sections">
          {tutorials.length ? (
            <section
              id="tutorials"
              class="content-section"
              aria-labelledby="tutorials-heading"
            >
              <div class="section-heading section-heading--with-copy">
                <div>
                  <h2 id="tutorials-heading">教程</h2>
                  <p>带着清晰步骤、代码与验证结果向前推进。</p>
                </div>
              </div>
              <PostList posts={tutorials} settings={settings} />
            </section>
          ) : null}

          {articles.length ? (
            <section
              id="articles"
              class="content-section"
              aria-labelledby="articles-heading"
            >
              <div class="section-heading section-heading--with-copy">
                <div>
                  <h2 id="articles-heading">文章</h2>
                  <p>围绕一个问题展开判断、证据与实现细节。</p>
                </div>
              </div>
              <PostList posts={articles} settings={settings} />
            </section>
          ) : null}
        </div>
      ) : (
        <EmptyState
          title="还没有公开的文章或教程"
          actionHref="/notes/"
          actionLabel="浏览现有笔记"
        >
          <p>较短的公开记录仍可以在笔记流中找到。</p>
        </EmptyState>
      )
    }
  </div>
</AppLayout>
