#!/bin/sh
set -eu

: "${MOCK_COMMAND_LOG:?Set MOCK_COMMAND_LOG}"
printf '%s\n' "restic $*" >>"$MOCK_COMMAND_LOG"

command=${1:-}
shift || true
case "$command" in
  backup)
    [ "${MOCK_RESTIC_BACKUP_FAIL:-0}" != 1 ] || exit 1
    backup_directory=${1:-}
    mode=$(stat -c '%a' "$backup_directory/postgres.dump")
    printf '%s\n' "dump-mode $mode" >>"$MOCK_COMMAND_LOG"
    ;;
  restore)
    target=
    while [ "$#" -gt 0 ]; do
      if [ "$1" = --target ]; then
        shift
        target=${1:-}
      fi
      shift || true
    done
    [ -n "$target" ]
    set_directory=$target/backup-staging/backup.fixture
    mkdir -p "$set_directory" "$target/data/uploads"
    printf 'fixture-postgresql-custom-dump\n' >"$set_directory/postgres.dump"
    checksum=$(sha256sum "$set_directory/postgres.dump" | cut -d ' ' -f 1)
    cat >"$set_directory/manifest.env" <<EOF
format_version=1
created_at=2026-08-04T00:00:00Z
dump_file=postgres.dump
dump_sha256=$checksum
dump_bytes=31
EOF
    printf 'fixture-upload\n' >"$target/data/uploads/example.webp"
    ;;
  snapshots)
    timestamp=${MOCK_SNAPSHOT_TIME:-2026-08-04T00:00:00Z}
    printf '[{"time":"%s"}]\n' "$timestamp"
    ;;
  forget | check) ;;
  *)
    echo "Unexpected Restic command: $command" >&2
    exit 1
    ;;
esac
