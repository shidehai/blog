[Unit]
Description=Create an encrypted off-VPS personal journal backup
Requires=docker.service
After=docker.service
OnFailure=blog-ops-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/blog
ExecStart=/usr/bin/docker compose --env-file /etc/blog/production.env --file /opt/blog/deploy/compose.yaml --profile backup run --rm backup
TimeoutStartSec=2h
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
