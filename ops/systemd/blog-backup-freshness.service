[Unit]
Description=Verify the latest personal journal backup is within RPO
Requires=docker.service
After=docker.service
OnFailure=blog-ops-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/personal-journal/current
ExecStart=/usr/bin/docker compose --env-file /etc/personal-journal/production.env --file /opt/personal-journal/current/deploy/compose.yaml --profile maintenance run --rm restic-maintenance freshness
TimeoutStartSec=15m
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
