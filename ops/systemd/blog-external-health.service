[Unit]
Description=Check the personal journal public HTTPS routes
After=network-online.target
Wants=network-online.target
OnFailure=blog-ops-alert@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/blog/deploy.env
ExecStart=/opt/blog/scripts/check-external-health.sh
NoNewPrivileges=true
PrivateTmp=true
