[Unit]
Description=Apply personal journal Restic retention and prune
Requires=docker.service
After=docker.service
OnFailure=blog-ops-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/blog
ExecStart=/usr/bin/docker compose --env-file /etc/blog/production.env --file /opt/blog/deploy/compose.yaml --profile maintenance run --rm restic-maintenance forget
TimeoutStartSec=6h
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
