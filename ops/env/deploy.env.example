# Root-owned, non-secret configuration sourced by scripts/deploy-site.sh.
DEPLOY_IMAGE_REPOSITORY=ghcr.io/example/blog
DEPLOY_SMOKE_URL=https://blog.example.com
DEPLOY_COMPOSE_ENV_FILE=/etc/blog/production.env
DEPLOY_COMPOSE_FILE=/opt/blog/deploy/compose.yaml
DEPLOY_STATE_DIR=/var/lib/blog/deploy
DEPLOY_TIMEOUT_SECONDS=90
DEPLOY_PREFLIGHT_PATHS='/healthz /'
