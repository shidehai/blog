# Root-owned, non-secret configuration sourced by scripts/deploy-site.sh.
DEPLOY_IMAGE_REPOSITORY=ghcr.io/example/personal-journal
DEPLOY_SMOKE_URL=https://blog.example.com
DEPLOY_COMPOSE_ENV_FILE=/etc/personal-journal/production.env
DEPLOY_COMPOSE_FILE=/opt/personal-journal/current/deploy/compose.yaml
DEPLOY_STATE_DIR=/var/lib/personal-journal/deploy
DEPLOY_TIMEOUT_SECONDS=90
DEPLOY_PREFLIGHT_PATHS='/healthz /'
