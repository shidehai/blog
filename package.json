{
  "name": "personal-knowledge-journal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "9.15.9"
  },
  "scripts": {
    "predev": "pnpm assets:generate",
    "dev": "node scripts/dev.mjs",
    "dev:v2": "pnpm --filter frontend-v2 dev",
    "build:v2": "pnpm --filter frontend-v2 build",
    "verify:v2": "pnpm --filter frontend-v2 verify",
    "prebuild": "pnpm assets:generate && node scripts/prepare-content.ts",
    "start": "node scripts/env.mjs runtime && node dist/server/entry.mjs",
    "build": "astro build && pnpm search:index",
    "search:index": "pagefind --site dist/client",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write --ignore-unknown .prettierrc.json README.md package.json astro.config.ts eslint.config.js playwright.config.ts tsconfig.json vitest.config.ts deploy directus scripts src tests",
    "format:check": "prettier --check --ignore-unknown .prettierrc.json README.md package.json astro.config.ts eslint.config.js playwright.config.ts tsconfig.json vitest.config.ts deploy directus scripts src tests",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:content": "vitest run tests/unit/content.test.ts tests/unit/references.test.ts tests/unit/media.test.ts",
    "test:markdown": "vitest run tests/unit/markdown.test.ts",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "test:components": "playwright test tests/e2e/shell.spec.ts",
    "test:search": "playwright test tests/e2e/discovery.spec.ts --grep search",
    "test:metadata": "vitest run tests/unit/metadata.test.ts && playwright test tests/e2e/discovery.spec.ts --grep metadata",
    "test:feed": "vitest run tests/unit/discovery.test.ts && playwright test tests/e2e/discovery.spec.ts --grep \"RSS|sitemap|robots|manifest|icon\"",
    "test:preview": "playwright test tests/e2e/preview.spec.ts",
    "test:publish-flow": "sh tests/ops/static-contract.test.sh && sh tests/ops/deploy.test.sh",
    "test:deployed-smoke": "sh scripts/http-smoke.sh",
    "test:headers": "node scripts/test-headers.mjs",
    "test:backup-restore": "sh tests/ops/backup-restore.test.sh",
    "test:operations": "sh tests/ops/run.sh && node scripts/verify-csp-hash.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "export:content": "node scripts/export-content.ts",
    "assets:generate": "node scripts/generate-assets.ts",
    "directus:schema:diff": "docker compose --env-file .env -f deploy/compose.yaml -f deploy/compose.dev.yaml exec -T directus node cli.js schema apply --dry-run --yes /directus/project/schema.yaml",
    "directus:schema:apply": "docker compose --env-file .env -f deploy/compose.yaml -f deploy/compose.dev.yaml exec -T directus node cli.js schema apply --yes /directus/project/schema.yaml && docker compose --env-file .env -f deploy/compose.yaml -f deploy/compose.dev.yaml exec -T postgres sh -c 'psql -v ON_ERROR_STOP=1 -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"' < directus/database.sql",
    "directus:bootstrap": "node --env-file=.env directus/bootstrap.mjs",
    "directus:seed": "node --env-file=.env directus/seed/index.mjs",
    "launch:plan": "node --env-file=.env directus/launch.mjs plan",
    "launch:apply": "node --env-file=.env directus/launch.mjs apply",
    "directus:schema:check": "node --env-file=.env tests/directus.mjs schema",
    "test:directus-access": "node --env-file=.env tests/directus.mjs access",
    "test:directus-workflow": "node --env-file=.env tests/directus.mjs workflow",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build && pnpm test:operations && pnpm test:e2e"
  },
  "dependencies": {
    "@astrojs/node": "11.0.3",
    "@directus/sdk": "24.0.0",
    "astro": "7.1.6",
    "github-slugger": "2.0.0",
    "hast-util-from-html": "2.0.3",
    "jsdom": "27.4.0",
    "mermaid": "11.16.1",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sanitize-html": "2.17.6",
    "sharp": "0.35.3",
    "shiki": "4.4.1",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/hast": "3.0.5",
    "@types/jsdom": "27.0.0",
    "@types/mdast": "4.0.4",
    "@types/node": "24.13.3",
    "@types/sanitize-html": "2.16.1",
    "chrome-launcher": "1.2.1",
    "eslint": "10.8.0",
    "eslint-plugin-astro": "1.5.0",
    "globals": "17.9.0",
    "lighthouse": "13.4.1",
    "pagefind": "1.5.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "nanoid": "3.3.18"
    }
  }
}
